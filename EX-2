import numpy as np

class Perceptron:
    def __init__(self, weights, bias):
        self.weights = np.array(weights)
        self.bias = bias

    def predict(self, X):
        net = np.dot(X, self.weights) + self.bias
        return 1 if net >= 0 else 0


weights = [-1, -1]
bias = 1.5

model = Perceptron(weights, bias)

X = np.array([
    [0, 0],
    [0, 1],
    [1, 0],
    [1, 1]
])

print("X1 X2 Output")

for x in X:
    print(x[0], x[1], model.predict(x))
