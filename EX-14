import numpy as np
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense

X = np.array([
    [0, 0],
    [0, 1],
    [1, 0],
    [1, 1]
], dtype=float)

y = np.array([0, 1, 1, 0], dtype=float)

# Original model
model1 = Sequential([
    Dense(4, input_dim=2, activation='sigmoid'),
    Dense(1, activation='sigmoid')
])

model1.compile(
    optimizer='adam',
    loss='binary_crossentropy',
    metrics=['accuracy']
)

history1 = model1.fit(
    X, y,
    epochs=500,
    verbose=0
)

# Two hidden layers
model2 = Sequential([
    Dense(4, input_dim=2, activation='sigmoid'),
    Dense(4, activation='sigmoid'),
    Dense(1, activation='sigmoid')
])

model2.compile(
    optimizer='adam',
    loss='binary_crossentropy',
    metrics=['accuracy']
)

history2 = model2.fit(
    X, y,
    epochs=500,
    verbose=0
)

loss1, acc1 = model1.evaluate(X, y, verbose=0)
loss2, acc2 = model2.evaluate(X, y, verbose=0)

print("One Hidden Layer")
print("Accuracy:", acc1)
print("Loss:", loss1)

print("\nTwo Hidden Layers")
print("Accuracy:", acc2)
print("Loss:", loss2)
