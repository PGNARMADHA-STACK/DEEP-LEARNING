import numpy as np
import matplotlib.pyplot as plt
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense

X = np.array([
    [0, 0],
    [0, 1],
    [1, 0],
    [1, 1]
], dtype=float)

y = np.array([0, 1, 1, 0], dtype=float)

epochs_list = [10, 30, 50, 100]

accuracy_values = []
loss_values = []

for epochs in epochs_list:

    model = Sequential([
        Dense(4, input_dim=2, activation='sigmoid'),
        Dense(1, activation='sigmoid')
    ])

    model.compile(
        optimizer='adam',
        loss='binary_crossentropy',
        metrics=['accuracy']
    )

    history = model.fit(
        X, y,
        epochs=epochs,
        verbose=0
    )

    loss, accuracy = model.evaluate(X, y, verbose=0)

    accuracy_values.append(accuracy)
    loss_values.append(loss)

# Accuracy plot
plt.figure()
plt.plot(epochs_list, accuracy_values, marker='o')
plt.xlabel("Number of Epochs")
plt.ylabel("Accuracy")
plt.title("Accuracy vs Epochs")
plt.grid()
plt.show()

# Loss plot
plt.figure()
plt.plot(epochs_list, loss_values, marker='o')
plt.xlabel("Number of Epochs")
plt.ylabel("Loss")
plt.title("Loss vs Epochs")
plt.grid()
plt.show()

for i in range(len(epochs_list)):
    print(
        "Epochs:", epochs_list[i],
        "Accuracy:", round(accuracy_values[i] * 100, 2),
        "Loss:", round(loss_values[i], 4)
    )
